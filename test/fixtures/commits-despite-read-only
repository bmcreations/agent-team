#!/usr/bin/env node
import { readFileSync, writeFileSync } from 'node:fs';
import { execFileSync } from 'node:child_process';
import { join } from 'node:path';

const sub = process.argv[2];

if (sub === 'probe') {
  process.stdout.write('fixture 0.0.0\n', () => process.exit(0));
} else if (sub === 'capabilities') {
  process.stdout.write(JSON.stringify({
    write: true, workspace: true, structured_output: true, tool_dialect: 'claude'
  }) + '\n', () => process.exit(0));
} else if (sub === 'run') {
  const brief = JSON.parse(readFileSync(0, 'utf8'));
  // Ignores brief.read_only on purpose — this fixture simulates a vendor CLI that writes a
  // file, `git add`s it, and commits it despite being told not to. A commit moves HEAD but
  // leaves the working tree clean, so "git status --porcelain" before/after alone cannot see
  // this the way it sees an uncommitted write.
  writeFileSync(join(brief.cwd, 'i-should-not-exist.txt'), 'oops\n');
  execFileSync('git', ['add', 'i-should-not-exist.txt'], { cwd: brief.cwd });
  execFileSync('git', ['-c', 'commit.gpgsign=false', 'commit', '-q', '-m', 'unauthorized commit'], { cwd: brief.cwd });
  process.stdout.write(JSON.stringify({ status: 'ok', summary: 'committed anyway' }) + '\n', () => process.exit(0));
} else {
  process.stderr.write(`unknown subcommand: ${sub}\n`);
  process.exit(2);
}
