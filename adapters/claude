#!/usr/bin/env node
import { readFileSync, mkdtempSync, writeFileSync, existsSync } from 'node:fs';
import { execFileSync, spawnSync } from 'node:child_process';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { answerOutcome } from '../src/delegation.js';

const sub = process.argv[2];

// How much diff text to keep verbatim in the report. Anything past this is truncated, but
// the truncation is signaled explicitly (diff_truncated / diff_full_length) rather than
// silently dropped.
const DIFF_KEEP_CHARS = 200_000;

// git diff's own stdout buffer. Node's default (~1 MB) is comfortably smaller than diffs this
// tool needs to read; overridable only for tests, so a deliberately tiny buffer can exercise
// the "diff too large to read" path without committing a multi-megabyte fixture.
const DIFF_MAX_BUFFER_DEFAULT = 20_000_000;
const rawDiffMaxBufferOverride = process.env.AGENT_TEAM_CLAUDE_DIFF_MAX_BUFFER;

// Only a finite positive integer is accepted. Anything else (non-numeric, negative, zero,
// fractional, Infinity) falls back to the default rather than reaching execFileSync: a bad
// value there throws ERR_OUT_OF_RANGE, which the diff-reading catch block below does not
// recognize (it only knows ENOBUFS / ERR_CHILD_PROCESS_STDIO_MAXBUFFER), so the throw is
// swallowed and a real diff silently comes back empty — the dangerous direction, since an
// unreadable diff must never read the same as "no diff". An operator's typo in this env var
// should not fail the run, but it must not be invisible either, hence diffMaxBufferInvalidOverride.
let DIFF_MAX_BUFFER = DIFF_MAX_BUFFER_DEFAULT;
let diffMaxBufferInvalidOverride = null;
if (rawDiffMaxBufferOverride !== undefined) {
  const parsed = Number(rawDiffMaxBufferOverride);
  if (Number.isInteger(parsed) && parsed > 0) {
    DIFF_MAX_BUFFER = parsed;
  } else {
    diffMaxBufferInvalidOverride = rawDiffMaxBufferOverride;
    console.warn(
      `AGENT_TEAM_CLAUDE_DIFF_MAX_BUFFER=${JSON.stringify(rawDiffMaxBufferOverride)} is not a ` +
      `positive integer; falling back to the default of ${DIFF_MAX_BUFFER_DEFAULT} bytes`
    );
  }
}

if (sub === 'probe') {
  const r = spawnSync('claude', ['--version'], { stdio: 'pipe' });
  if (r.status !== 0) { process.stderr.write('claude not on PATH\n'); process.exit(1); }
  process.stdout.write(r.stdout.toString().trim() + '\n', () => process.exit(0));
} else if (sub === 'capabilities') {
  process.stdout.write(JSON.stringify({
    write: true, workspace: true, structured_output: true, tool_dialect: 'claude'
  }) + '\n', () => process.exit(0));
} else if (sub === 'run') {
  const brief = JSON.parse(readFileSync(0, 'utf8'));
  const logDir = mkdtempSync(join(tmpdir(), 'agent-team-claude-'));
  const logPath = join(logDir, 'session.log');

  if (!existsSync(brief.cwd)) {
    // Checked up front, before spawning: spawnSync's own ENOENT is reported identically
    // whether the "claude" binary is missing from PATH or brief.cwd itself does not exist, so
    // cwd is verified here to keep the two causes apart instead of guessing after the fact.
    writeFileSync(logPath, '');
    process.stdout.write(JSON.stringify({
      status: 'failed', summary: `cwd does not exist: ${brief.cwd}`, log_path: logPath
    }) + '\n', () => process.exit(0));
  } else {
    const args = ['-p', brief.task, '--output-format', 'json'];
    if (brief.model) args.push('--model', brief.model);
    if (brief.effort) args.push('--effort', brief.effort);
    // No advisor flag exists; advisorModel is a settings key, and --settings takes a JSON
    // string merged over the user's settings. Claude Code can still skip the advisor (the
    // executor outranks it, the feature is off for the account, a third-party provider);
    // `claude --debug` logs "[AdvisorTool] Skipping advisor - <reason>" when it does.
    if (brief.advisor) args.push('--settings', JSON.stringify({ advisorModel: brief.advisor }));
    // With no mode, headless `claude -p` refuses every tool call that would prompt, and only
    // the user's own allowlist gets through, so a workspace member could not edit its clone.
    args.push('--permission-mode', brief.read_only ? 'plan' : (brief.permission_mode ?? 'auto'));

    const timeoutMs = (brief.timeout_s ?? 900) * 1000;
    const r = spawnSync('claude', args, { cwd: brief.cwd, stdio: 'pipe', timeout: timeoutMs });

    writeFileSync(logPath, (r.stdout ?? '').toString() + (r.stderr ?? '').toString());

    if (r.status === null) {
      // The process never produced a numeric exit code: it either never started or was killed.
      // brief.cwd was confirmed to exist above, but that check and this spawn are not atomic —
      // it is a time-of-check/time-of-use gap, not a guarantee. If brief.cwd is removed in the
      // window between the check and the spawn, the ENOENT below comes from the now-missing
      // cwd, not from a missing "claude" binary, and the two are indistinguishable from here.
      // That race is exceedingly unlikely in practice, so the common cause is still named, but
      // without claiming a certainty this check does not have.
      // Empirically verified on this Node version (v26): spawnSync's own `timeout` option sets
      // BOTH error.code === 'ETIMEDOUT' AND signal === 'SIGTERM' when it fires. So ETIMEDOUT
      // alone is sufficient to identify our own timeout, and a bare SIGTERM with no ETIMEDOUT
      // is something else entirely — the child was killed by something outside this process
      // (an OOM killer, `pkill claude`, a supervisor). Reporting every SIGTERM as "timed out
      // after Nms" fabricates a duration and a cause that this signal alone does not establish.
      let summary;
      if (r.error?.code === 'ETIMEDOUT') {
        summary = `claude timed out after ${timeoutMs}ms`;
      } else if (r.error?.code === 'ENOENT') {
        summary = 'claude is not installed or not on PATH (or brief.cwd was removed after being checked)';
      } else if (r.signal) {
        summary = `claude was terminated by signal ${r.signal}`;
      } else {
        summary = `claude exited abnormally (signal: none, error: ${r.error?.code ?? 'unknown'})`;
      }
      process.stdout.write(JSON.stringify({
        status: 'failed', summary, log_path: logPath
      }) + '\n', () => process.exit(0));
    } else if (r.status !== 0) {
      process.stdout.write(JSON.stringify({
        status: 'failed', summary: `claude exited ${r.status}`, log_path: logPath
      }) + '\n', () => process.exit(0));
    } else {
      let summary = '';
      let denied = [];
      try {
        const envelope = JSON.parse(r.stdout.toString());
        summary = envelope.result ?? '';
        denied = (envelope.permission_denials ?? []).map((d) => d.tool_name);
      } catch { summary = r.stdout.toString().slice(0, 4000); }

      let diff = '';
      let diffUnreadable = false;
      try {
        // `git diff HEAD` never shows an untracked path, so a member that CREATES a file —
        // a new source file, a new test — handed back an empty diff while reporting success,
        // and the manager saw no work. Intent-to-add (`add -A -N`) makes the new file visible
        // to diff. It is staged into a THROWAWAY index, never the workspace's own: a read_only
        // brief's conformance check compares `git status --porcelain` from before the run to
        // after it, and touching the real index would turn "?? new.txt" into "A  new.txt" and
        // report a read-only violation that never happened.
        const diffIndex = join(logDir, 'diff-index');
        const gitEnv = { ...process.env, GIT_INDEX_FILE: diffIndex };
        execFileSync('git', ['-C', brief.cwd, 'read-tree', 'HEAD'], { stdio: 'pipe', env: gitEnv });
        execFileSync('git', ['-C', brief.cwd, 'add', '-A', '-N'], { stdio: 'pipe', env: gitEnv });
        diff = execFileSync('git', ['-C', brief.cwd, 'diff', 'HEAD'], {
          stdio: 'pipe', maxBuffer: DIFF_MAX_BUFFER, env: gitEnv
        }).toString();
      } catch (e) {
        if (e.code === 'ENOBUFS' || e.code === 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER') {
          // The diff exists but is too large to capture — distinct from "no diff", which is
          // the normal outcome when brief.cwd is not a git repo or has no changes.
          diffUnreadable = true;
        }
      }

      let branch = null;
      try { branch = execFileSync('git', ['-C', brief.cwd, 'branch', '--show-current'], { stdio: 'pipe' }).toString().trim(); }
      catch { /* ignore */ }

      // A workspace member with refused tool calls may not have done its work, whatever its
      // summary says. Reporting ok let dispatch prune the workspace, leaving only the session
      // log to show what happened. An empty diff is no test: user hooks run in the clone too
      // and can write files there. failed keeps the workspace and still returns the diff.
      const refused = !brief.read_only && denied.length > 0;
      const outcome = refused
        ? {
            status: 'failed',
            summary: `claude refused ${denied.length} tool call(s): ${denied.join(', ')}. ` +
              `Member summary: ${summary}`
          }
        : answerOutcome(summary, brief);

      process.stdout.write(JSON.stringify({
        ...outcome,
        permission_denials: denied,
        findings: [],
        checked_sound: [],
        artifacts: {
          branch,
          diff: diff.slice(0, DIFF_KEEP_CHARS),
          diff_truncated: diff.length > DIFF_KEEP_CHARS,
          diff_full_length: diff.length,
          diff_unreadable: diffUnreadable,
          diff_max_buffer_invalid_override: diffMaxBufferInvalidOverride
        },
        log_path: logPath
      }) + '\n', () => process.exit(0));
    }
  }
} else {
  process.stderr.write(`unknown subcommand: ${sub}\n`);
  process.exit(2);
}
