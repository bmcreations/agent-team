#!/usr/bin/env node
import { readFileSync, writeFileSync, existsSync } from 'node:fs';

const sub = process.argv[2];

if (sub === 'probe') {
  process.stdout.write('mock 0.1.0\n');
  process.exit(0);
}

if (sub === 'capabilities') {
  process.stdout.write(JSON.stringify({
    write: true, workspace: true, structured_output: true, tool_dialect: 'claude'
  }) + '\n');
  process.exit(0);
}

if (sub === 'run') {
  const brief = JSON.parse(readFileSync(0, 'utf8'));
  const scriptPath = process.env.AGENT_TEAM_MOCK_SCRIPT;
  if (!scriptPath) {
    process.stderr.write('AGENT_TEAM_MOCK_SCRIPT is not set\n');
    process.exit(2);
  }
  const scripted = JSON.parse(readFileSync(scriptPath, 'utf8'));
  const entry = (scripted.by_member && scripted.by_member[brief.member]) ?? scripted;

  // A member's scripted answer is either a single object (used for every call) or an
  // array of answers consumed one per call — e.g. delegate on round one, synthesize on
  // round two. The mock is a separate process per invocation, so "one per call" needs
  // state on disk: a counter file next to the script, keyed by member.
  let picked;
  if (Array.isArray(entry)) {
    const countsPath = `${scriptPath}.calls.json`;
    const counts = existsSync(countsPath) ? JSON.parse(readFileSync(countsPath, 'utf8')) : {};
    const count = counts[brief.member] ?? 0;
    picked = entry[Math.min(count, entry.length - 1)];
    counts[brief.member] = count + 1;
    writeFileSync(countsPath, JSON.stringify(counts));
  } else {
    picked = entry;
  }

  if (picked.hang) {
    // never exits; the caller's timeout has to kill the process group. Task 8 exercises this.
    setInterval(() => {}, 1000);
  } else {
    process.stdout.write(JSON.stringify({ ...picked, received: brief }) + '\n');
    process.exit(0);
  }
} else {
  process.stderr.write(`unknown subcommand: ${sub}\n`);
  process.exit(2);
}
